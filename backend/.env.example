# Copy to backend/.env for local development only, or inject these names with
# Infisical. Never commit backend/.env or place values in this template.
APP_ENV=development
MONGO_URL=mongodb://localhost:27017
DB_NAME=coach_max_dev
CORS_ORIGINS=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Optional server-only provider secrets. Use newly issued BrownTD-owned values.
# EMERGENT_LLM_KEY is legacy-only while the provider-neutral AI adapter is built.
EMERGENT_LLM_KEY=
RESEND_API_KEY=
# Thinkific is a migration source, not a launch runtime dependency. Do not set in
# new environments; these names remain documented until retirement is merged.
THINKIFIC_API_KEY=

# Server-only configuration. Email addresses can be personal data even though
# they are not authentication secrets.
SENDER_EMAIL=
NOTIFICATION_EMAIL=
SUPER_ADMIN_EMAIL=
THINKIFIC_SUBDOMAIN=
